# Copy this file to .env (already gitignored) and fill in your own key.
# Get a Gemini API key from https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash if unset — check
# https://ai.google.dev/gemini-api/docs/models for the current model list.
GEMINI_MODEL=
# Optional, comma-separated. Models offered in the /assistant/ dropdown.
# GEMINI_MODEL above is always included even if you leave it out here. The available
# model names depend on your API key/account tier — run `client.models.list()`
# (see google-genai docs) if unsure what you actually have access to.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-pro-latest,gemini-flash-latest,gemini-3.1-flash-lite

# LaTeX CV support (see DEPLOY.md). Optional — default to plain `pandoc`/`latexmk` on
# $PATH. Set these if you installed portable binaries instead (e.g. PythonAnywhere,
# where there's no root/apt): point at your pypandoc-downloaded pandoc and your
# TinyTeX install's latexmk.
PANDOC_BIN=
LATEXMK_BIN=

# HTTP tool API (/api/, see CLAUDE.md). Server side: a long random string; under 32 chars (or
# blank) disables the API. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ASSISTANT_API_TOKEN=
# Client side (your PC, read by tools/site_api.py): the SAME value as the server's token.
SITE_API_TOKEN=
# Optional, defaults to https://www.vpippi.com (the bare domain redirects there)
SITE_API_URL=
